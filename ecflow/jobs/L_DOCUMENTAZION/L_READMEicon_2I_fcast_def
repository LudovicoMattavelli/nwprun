#5.7.0
suite icon_2I_fcast
  edit ECF_INCLUDE '/g100_work/smr_prod/lmattavelli/dir_progetto_v0/nwprun/ecflow/include_slurm'
  edit ECF_FILES '/g100_work/smr_prod/lmattavelli/dir_progetto_v0/nwprun/ecflow/jobs'
  edit BASEDIR '/g100_work/smr_prod/lmattavelli/dir_progetto_v0/nwprun'
  edit ECF_HOME '/g100_work/smr_prod/lmattavelli/dir_progetto_v0/ecflow'
  edit ecflow_client '/g100_work/smr_prod/lmattavelli/dir_progetto_v0/nwprun/ecflow/ec_wrap ecflow_client'
  edit ECF_TRIES '2'
  edit ECF_JOB_CMD '(date -u '+%%Y%%m%%d%%H%%M'; sbatch %EXTRA_SCHED:% %ECF_JOB%) >>%ECF_HOME%/sbatch.log 2>&1'
  edit ECF_KILL_CMD 'scancel %ECF_RID%'
  edit ECF_STATUS_CMD 'squeue -j %ECF_RID%'
  edit NO_FAIL 'FALSE'
  edit TASK_PER_CORE '1'
  edit HPCENV 'g100'
  edit ECF_TIMEOUT '7200'
  edit ECF_DENIED ''
  edit WALL_TIME_WAIT '04:10:00'
  edit WALL_TIME_ARCHIVE '04:10:00'
  edit NWPCONF 'prod/icon_2I/fcast'
  edit NNODES_PREMODEL '2'
  edit NNODES_MODEL '16'
  edit NTASKS_POSTPROC '2'
  edit WALL_TIME_PREMODEL '00:20:00'
  edit WALL_TIME_MODEL '02:00:00'
  family day
    repeat date YMD 20250821 20301228 1
    family hour_00
      edit TIME '00'
      edit RADVOL 'N'
      family check_run
        complete check_run/can_run == complete
        edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
        edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
        edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
        task can_run
          trigger check_run:checked
          event ready
        task check_run
          complete can_run:ready
          event checked
          cron 00:00 23:50 00:10 ## Ogni 10 minuti viene lanciato e controlla se ci sono le condizioni per far partire la simulazione (es. arrivo di dati, completamento di pre-processi, disponibilità di file). Appena la condizione è soddisfatta, emette checked e sblocca can_run e si passerà poi alla famiglia successiva
      endfamily
      family run
        trigger check_run == complete
       ## family get_obs
       ##   task get_radarlhn_icon
       ##     edit NO_FAIL 'TRUE'
       ## endfamily
        family eps_members
          family deterministic
            complete deterministic/check_memb:required == 1
            edit ECF_ENS_MEMB '0'
            task check_memb
              edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
              edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
              edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
              meter required 0 2 2 			## Boh?? definisce un contatore (required) con range da 0 a 2, inizializzato a 2
            family preproc
              trigger ./check_memb:required == 2
              task get_parent
                edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
                edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
                edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
              task preicon
                trigger ./get_parent == complete
              task merge_analysis_icon
                trigger ./preicon == complete
            endfamily
            family model
              trigger ./preproc == complete && ../../get_obs/get_radarlhn_icon == complete
              task icon
                event started
              task postproc_icon
                trigger ./icon:started == set
            endfamily
            family wipe
              edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
              edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
              edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
              task wipe_member
                complete ../model == complete
                trigger ../model == aborted || ../preproc == aborted || ../check_memb == aborted
            endfamily
          endfamily
        endfamily
      endfamily
      family wipe
        edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
        edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
        edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
        task wipe_run
          complete ../run == complete
          trigger ../run/get_obs == aborted
      endfamily
    endfamily
    family hour_12
      edit TIME '12'
      edit RADVOL 'N'
      family check_run
        complete check_run/can_run == complete
        edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
        edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
        edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
        task can_run
          trigger check_run:checked
          event ready
        task check_run
          complete can_run:ready
          trigger ../../hour_00 == complete
          event checked
          cron 00:00 23:50 00:10
      endfamily
      family run
        trigger check_run == complete
        family get_obs
          task get_radarlhn_icon
            edit NO_FAIL 'TRUE'
        endfamily
        family eps_members
          family deterministic
            complete deterministic/check_memb:required == 1
            edit ECF_ENS_MEMB '0'
            task check_memb
              edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
              edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
              edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
              meter required 0 2 2
            family preproc
              trigger ./check_memb:required == 2
              task get_parent
                edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
                edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
                edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
              task preicon
                trigger ./get_parent == complete
              task merge_analysis_icon
                trigger ./preicon == complete
            endfamily
            family model
              trigger ./preproc == complete && ../../get_obs/get_radarlhn_icon == complete
              task icon
                event started
              task postproc_icon
                trigger ./icon:started == set
            endfamily
            family wipe
              edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
              edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
              edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
              task wipe_member
                complete ../model == complete
                trigger ../model == aborted || ../preproc == aborted || ../check_memb == aborted
            endfamily
          endfamily
        endfamily
      endfamily
      family wipe
        edit ECF_JOB_CMD '%ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
        edit ECF_KILL_CMD 'kill -15 %ECF_RID%'
        edit ECF_STATUS_CMD 'ps --sid %ECF_RID% -f'
        task wipe_run
          complete ../run == complete
          trigger ../run/get_obs == aborted
      endfamily
    endfamily
  endfamily
endsuite
